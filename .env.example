# Adresse publique du site, utilisée pour les métadonnées et les aperçus de
# liens (Open Graph). Facultative : sans elle, l'application retombe sur le
# domaine de production, ou sur l'URL du déploiement de préproduction Vercel.
NEXT_PUBLIC_SITE_URL=

# Stockage S3 / Cloudflare R2 utilisé par le partage (QR code volumineux et
# codes à recopier). Sans ces variables, /api/share répond 503 et l'application
# se limite aux QR codes autonomes, qui ne quittent jamais l'appareil.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Mesure d'audience PostHog (facultative).
#
# Sans NEXT_PUBLIC_POSTHOG_KEY, aucun script de mesure n'est chargé et aucune
# requête ne part : l'application fonctionne à l'identique. Avec la clé, la
# mesure reste soumise au consentement explicite du visiteur, et se limite aux
# événements décrits dans src/lib/analytics/events.ts.
#
# L'hôte par défaut est l'instance européenne : les données restent dans l'UE.
# Voir docs/analytics-rgpd.md pour les réglages à appliquer côté projet PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Générateur d'itinéraire intégré (/api/generate) : la clé d'API Anthropic,
# lue uniquement côté serveur — elle n'est jamais envoyée au navigateur. Sans
# elle, /api/generate répond 503 et l'app propose le générateur du site
# tripbrain.fr à la place.
ANTHROPIC_API_KEY=
# Modèle et niveau d'effort du générateur (facultatifs). Par défaut
# claude-opus-5-5 à l'effort « low » ; claude-sonnet-5-5 coûte moitié moins.
GENERATOR_MODEL=
GENERATOR_EFFORT=
