{
  "expo": {
    "name": "TripBrain",
    "slug": "tripbrain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripbrain",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f3f7fd",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.tripbrain.app",
      "associatedDomains": ["applinks:app.tripbrain.fr"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "LSApplicationQueriesSchemes": ["comgooglemaps", "maps"],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Voyage TripBrain",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.json",
              "org.openxmlformats.spreadsheetml.sheet"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f3f7fd"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.tripbrain.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.tripbrain.fr",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "file",
              "mimeType": "application/json"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f3f7fd",
          "dark": {
            "backgroundColor": "#0d172b"
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "TripBrain utilise l'appareil photo pour lire le QR code d'un voyage partagé.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2268c7",
          "defaultChannel": "voyage"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "TripBrain ajoute les journées de votre voyage à votre calendrier.",
          "writeOnlyAccess": true
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcc51450-ae3f-40c8-92d4-b8202a0d2a7b"
      }
    },
    "owner": "abderrahmanemouzounes-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fcc51450-ae3f-40c8-92d4-b8202a0d2a7b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
