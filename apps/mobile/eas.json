{
  "cli": { "version": ">= 20.2.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_WEBAPP_URL": "https://app.tripbrain.fr"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_WEBAPP_URL": "https://app.tripbrain.fr"
      }
    }
  },
  "update": {
    "preview": { "channel": "preview" },
    "production": { "channel": "production" }
  },
  "submit": {
    "production": {}
  }
}
